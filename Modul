                    value: 15,
                    description: 'Tingkat pemahaman teknologi yang bervariasi di kalangan bidan dan pasien dapat menghambat adopsi dan pemanfaatan optimal.',
                    solution: 'Solusi: Menyediakan pelatihan berkala, tutorial interaktif, dan dukungan teknis yang mudah diakses untuk meningkatkan kompetensi digital.'
                },
                {
                    label: 'Biaya',
                    value: 10,
                    description: 'Investasi awal untuk berlangganan platform atau pengadaan perangkat pendukung bisa menjadi hambatan bagi praktik mandiri.',
                    solution: 'Solusi: Mendorong model bisnis yang fleksibel (misalnya, pembayaran per-pasien) dan mengadvokasi subsidi dari pemerintah atau lembaga kesehatan.'
                }
            ];

            const quizQuestions = [
                {
                    question: "Apa manfaat utama aplikasi web dalam manajemen rekam medis?",
                    options: [
                        "Menambah jumlah dokumen fisik",
                        "Memerlukan lebih banyak ruang penyimpanan",
                        "Mengurangi risiko kehilangan atau kerusakan data fisik",
                        "Meningkatkan biaya administrasi"
                    ],
                    answer: "Mengurangi risiko kehilangan atau kerusakan data fisik",
                    rationale: "Penggunaan rekam medis elektronik (RME) secara digital meminimalisir risiko kehilangan, kerusakan, atau pencurian data yang sering terjadi pada dokumen fisik."
                },
                {
                    question: "Fitur manajemen praktik seperti penjadwalan janji temu otomatis membantu bidan dalam hal?",
                    options: [
                        "Mengurangi interaksi dengan pasien",
                        "Membebaskan waktu untuk lebih fokus pada asuhan klinis",
                        "Memerlukan staf tambahan",
                        "Meningkatkan beban kerja administratif"
                    ],
                    answer: "Membebaskan waktu untuk lebih fokus pada asuhan klinis",
                    rationale: "Otomatisasi tugas administratif, seperti penjadwalan, memungkinkan bidan untuk mengurangi pekerjaan non-klinis dan mendedikasikan lebih banyak waktu dan perhatian pada asuhan pasien secara langsung."
                },
                {
                    question: "Di kategori aplikasi mana Anda akan menemukan fitur seperti 'panggilan video' dan 'pengiriman resep digital'?",
                    options: [
                        "Manajemen Praktik & RME",
                        "Telehealth & Komunikasi",
                        "Referensi & Edukasi Klinis",
                        "Edukasi Pasien"
                    ],
                    answer: "Telehealth & Komunikasi",
                    rationale: "Telehealth secara spesifik mengacu pada penyediaan layanan kesehatan jarak jauh, yang mencakup konsultasi melalui panggilan video dan pengiriman resep atau informasi secara digital."
                },
                {
                    question: "Apa tantangan utama implementasi aplikasi berbasis web yang sering ditemui di wilayah pedesaan atau terpencil?",
                    options: [
                        "Tingkat literasi digital",
                        "Biaya investasi awal",
                        "Konektivitas Internet",
                        "Interoperabilitas sistem"
                    ],
                    answer: "Konektivitas Internet",
                    rationale: "Di daerah pedesaan atau terpencil, infrastruktur internet yang tidak memadai seringkali menjadi hambatan utama dalam adopsi aplikasi berbasis web yang membutuhkan koneksi stabil."
                },
                {
                    question: "Tujuan dari fitur 'dukungan keputusan klinis berbasis bukti' adalah?",
                    options: [
                        "Menggantikan peran bidan",
                        "Memastikan keputusan klinis tidak lagi diperlukan",
                        "Membantu bidan membuat keputusan yang lebih tepat dan berbasis data ilmiah",
                        "Meningkatkan jumlah pasien"
                    ],
                    answer: "Membantu bidan membuat keputusan yang lebih tepat dan berbasis data ilmiah",
                    rationale: "Fitur ini menyediakan akses ke data, panduan, dan riset terbaru, yang membantu bidan membuat keputusan klinis yang informatif, akurat, dan sesuai dengan standar praktik terkini."
                }
            ];

            const tabButtons = document.querySelectorAll('.tab-button');
            const tabContentArea = document.getElementById('tab-content-area');
            const tabTitle = document.getElementById('tab-title');
            const tabFunction = document.getElementById('tab-function');
            const tabFeatures = document.getElementById('tab-features');
            const quizForm = document.getElementById('quiz-form');
            const quizResults = document.getElementById('quiz-results');
            const resultsTitle = document.getElementById('results-title');
            const resultsMessage = document.getElementById('results-message');
            const quizFeedback = document.getElementById('quiz-feedback');
            const modeSelector = document.getElementById('mode-selector');
            const timerDisplay = document.getElementById('timer-display');
            const timeLeftSpan = document.getElementById('time-left');

            let currentMode = 'learning';
            let timerInterval;

            function switchMode(mode) {
                currentMode = mode;
                clearInterval(timerInterval);
                timerDisplay.classList.add('hidden');
                quizFeedback.classList.add('hidden');
                quizResults.classList.add('hidden');
                quizForm.classList.remove('pointer-events-none');
                renderQuiz();

                if (currentMode === 'practice') {
                    startTimer(300); // 5 minutes
                }
            }

            modeSelector.addEventListener('change', (e) => {
                switchMode(e.target.value);
            });

            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    tabButtons.forEach(btn => {
                        btn.classList.remove('border-sky-600', 'text-sky-600');
                        btn.classList.add('border-transparent', 'text-slate-500', 'hover:text-slate-700', 'hover:border-slate-300');
                    });
                    button.classList.add('border-sky-600', 'text-sky-600');
                    button.classList.remove('border-transparent', 'text-slate-500', 'hover:text-slate-700', 'hover:border-slate-300');

                    const category = button.dataset.category;
                    const data = appData[category];
                    
                    tabContentArea.style.opacity = '0';
                    setTimeout(() => {
                        tabTitle.textContent = data.title;
                        tabFunction.textContent = data.function;
                        tabFeatures.innerHTML = data.features.map(feature => `<div class="bg-slate-100 p-4 rounded-lg text-slate-700">${feature}</div>`).join('');
                        tabContentArea.style.opacity = '1';
                    }, 300);
                });
            });

            const ctx = document.getElementById('challengesChart').getContext('2d');
            const challengesChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: challengeData.map(d => d.label),
                    datasets: [{
                        data: challengeData.map(d => d.value),
                        backgroundColor: ['#0284c7', '#38bdf8', '#7dd3fc', '#bae6fd', '#e0f2fe'],
                        borderColor: '#ffffff',
                        borderWidth: 4,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#475569',
                                padding: 20,
                            }
                        },
                        tooltip: {
                            enabled: false
                        }
                    },
                    onClick: (event, elements) => {
                        if (elements.length > 0) {
                            const index = elements[0].index;
                            const data = challengeData[index];
                            document.getElementById('modal-title').textContent = data.label;
                            document.getElementById('modal-description').textContent = data.description;
                            document.getElementById('modal-solution').textContent = data.solution;
                            document.getElementById('modal-container').classList.add('visible');
                        }
                    }
                }
            });

            document.getElementById('close-modal-btn').addEventListener('click', () => {
                document.getElementById('modal-container').classList.remove('visible');
            });

            document.getElementById('modal-container').addEventListener('click', (e) => {
                if (e.target.id === 'modal-container') {
                    document.getElementById('modal-container').classList.remove('visible');
                }
            });

            document.getElementById('toggle-biblio').addEventListener('click', function() {
                const content = document.getElementById('biblio-content');
                const icon = document.getElementById('biblio-icon');
                content.classList.toggle('expanded');
                icon.classList.toggle('rotate-180');
            });

            function toggleDetails(element) {
                const content = element.querySelector('.details-content');
                const isExpanded = content.classList.contains('expanded');

                document.querySelectorAll('.details-content.expanded').forEach(openContent => {
                    if (openContent !== content) {
                        openContent.classList.remove('expanded');
                    }
                });
                
                if (!isExpanded) {
                    content.classList.add('expanded');
                }
            }

            function renderQuiz() {
                quizForm.innerHTML = '';
                quizQuestions.forEach((q, index) => {
                    const questionDiv = document.createElement('div');
                    questionDiv.classList.add('mb-6');
                    questionDiv.innerHTML = `
                        <p class="font-semibold text-lg mb-4 text-slate-800">${index + 1}. ${q.question}</p>
                        <div id="options-${index}" class="space-y-3">
                            ${q.options.map(option => `
                                <label class="quiz-option block p-4 rounded-lg shadow-sm">
                                    <input type="radio" name="question${index}" value="${option}" class="mr-2 hidden">
                                    <span>${option}</span>
                                </label>
                            `).join('')}
                        </div>
                    `;
                    quizForm.appendChild(questionDiv);
                });

                if (currentMode === 'practice') {
                    const submitButton = document.createElement('button');
                    submitButton.textContent = 'Kirim Jawaban';
                    submitButton.type = 'submit';
                    submitButton.classList.add('mt-6', 'w-full', 'px-6', 'py-3', 'bg-sky-600', 'text-white', 'font-semibold', 'rounded-full', 'shadow-lg', 'hover:bg-sky-700', 'transition-colors');
                    quizForm.appendChild(submitButton);
                }
            }
            
            function checkAnswerLearningMode(e) {
                const selectedLabel = e.target.closest('label');
                const input = selectedLabel.querySelector('input');
                const questionIndex = parseInt(input.name.replace('question', ''), 10);
                const question = quizQuestions[questionIndex];
                
                quizFeedback.classList.remove('hidden', 'bg-green-100', 'text-green-800', 'bg-red-100', 'text-red-800');
                
                if (input.value === question.answer) {
                    selectedLabel.classList.add('correct');
                    quizFeedback.classList.add('bg-green-100', 'text-green-800');
                    quizFeedback.innerHTML = `<strong>Benar!</strong><br>${question.rationale}`;
                } else {
                    selectedLabel.classList.add('incorrect');
                    quizFeedback.classList.add('bg-red-100', 'text-red-800');
                    quizFeedback.innerHTML = `<strong>Salah.</strong> Jawaban yang benar adalah: **${question.answer}**.<br>${question.rationale}`;
                }

                // Disable all options for this question
                const optionsDiv = document.getElementById(`options-${questionIndex}`);
                optionsDiv.querySelectorAll('input').forEach(opt => opt.disabled = true);
            }

            function checkAnswersPracticeMode(isTimeout = false) {
                clearInterval(timerInterval);
                quizForm.classList.add('pointer-events-none');
                let score = 0;
                let allQuestionsAnswered = true;

                quizQuestions.forEach((q, index) => {
                    const selectedOption = document.querySelector(`input[name="question${index}"]:checked`);
                    
                    if (!selectedOption) {
                        allQuestionsAnswered = false;
                        return;
                    }
                    
                    const labels = document.querySelectorAll(`input[name="question${index}"]`);
                    labels.forEach(input => {
                        const label = input.closest('label');
                        label.classList.remove('selected');
                        label.style.pointerEvents = 'none';

                        if (input.value === q.answer) {
                            label.classList.add('correct');
                        }
                    });

                    if (selectedOption.value === q.answer) {
                        score++;
                    } else {
                        selectedOption.closest('label').classList.add('incorrect');
                    }
                });

                showResults(score, allQuestionsAnswered, isTimeout);
            }

            function showResults(score, allAnswered, isTimeout) {
                const totalQuestions = quizQuestions.length;
                quizResults.classList.remove('hidden');
                
                let title, message, bgColor;

                if (!allAnswered && !isTimeout) {
                    alert('Mohon jawab semua pertanyaan sebelum mengirim.');
                    return;
                }
                
                if (isTimeout) {
                    title = "Waktu Habis!";
                    message = `Anda tidak menyelesaikan semua pertanyaan tepat waktu. Skor Anda: ${score}/${totalQuestions}.`;
                    bgColor = "bg-red-100 text-red-800";
                } else if (score === totalQuestions) {
                    title = "Luar Biasa!";
                    message = `Anda berhasil menjawab semua pertanyaan dengan benar. Skor Anda: ${score}/${totalQuestions}. Anda sudah menguasai modul ini!`;
                    bgColor = "bg-green-100 text-green-800";
                } else if (score >= totalQuestions / 2) {
                    title = "Kerja Bagus!";
                    message = `Skor Anda: ${score}/${totalQuestions}. Anda memiliki pemahaman yang baik. Periksa kembali jawaban yang salah untuk meningkatkan pemahaman Anda.`;
                    bgColor = "bg-yellow-100 text-yellow-800";
                } else {
                    title = "Terus Berusaha!";
                    message = `Skor Anda: ${score}/${totalQuestions}. Jangan putus asa! Silakan ulangi modul dan coba lagi.`;
                    bgColor = "bg-red-100 text-red-800";
                }

                resultsTitle.textContent = title;
                resultsMessage.textContent = message;
                quizResults.className = `mt-8 p-6 rounded-lg ${bgColor}`;
                
                document.getElementById('evaluasi').scrollIntoView({ behavior: 'smooth' });
            }

            function startTimer(duration) {
                timerDisplay.classList.remove('hidden');
                let timer = duration;
                timerInterval = setInterval(() => {
                    let minutes = parseInt(timer / 60, 10);
                    let seconds = parseInt(timer % 60, 10);

                    minutes = minutes < 10 ? "0" + minutes : minutes;
                    seconds = seconds < 10 ? "0" + seconds : seconds;

                    timeLeftSpan.textContent = `${minutes}:${seconds}`;

                    if (--timer < 0) {
                        clearInterval(timerInterval);
                        checkAnswersPracticeMode(true);
                        timeLeftSpan.textContent = "00:00";
                    }
                }, 1000);
            }

            const downloadButton = document.getElementById('download-button');
            downloadButton.addEventListener('click', () => {
                const htmlContent = document.documentElement.outerHTML;
                const blob = new Blob([htmlContent], { type: 'text/html' });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = 'Modul-Kebidanan-Digital.html';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            });

            quizForm.addEventListener('change', (e) => {
                if (e.target.type === 'radio') {
                    const selectedLabel = e.target.closest('label');
                    const questionDiv = selectedLabel.closest('div[id^="options-"]');
                    const allOptions = questionDiv.querySelectorAll('.quiz-option');

                    allOptions.forEach(opt => opt.classList.remove('selected'));
                    selectedLabel.classList.add('selected');

                    if (currentMode === 'learning') {
                        checkAnswerLearningMode(e);
                    }
                }
            });

            quizForm.addEventListener('submit', function(e) {
                e.preventDefault();
                if (currentMode === 'practice') {
                    checkAnswersPracticeMode(false);
                }
            });

            // Initial render
            switchMode('learning');
        });

        function toggleDetails(element) {
            const content = element.querySelector('.details-content');
            const isExpanded = content.classList.contains('expanded');
            
            document.querySelectorAll('.details-content.expanded').forEach(openContent => {
                if (openContent !== content) {
                    openContent.classList.remove('expanded');
                }
            });
            
            if (!isExpanded) {
                content.classList.add('expanded');
            }
        }
    </script>
</body>
</html>
